#!/usr/bin/env bash
# Mars pre-commit hook: format/lint with Biome, then typecheck with tsc via Bun.
# Per ARCHITECTURE.md §8. Install with: framework/scripts/install-hooks.sh
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT/framework"

# Only run on staged TS/TSX/JS/JSON changes inside framework/.
STAGED=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^framework/.*\.(ts|tsx|js|jsx|json)$' || true)
if [ -z "$STAGED" ]; then
  exit 0
fi

bunx --bun biome check --write .
bunx tsc --noEmit

# Re-stage anything Biome reformatted.
echo "$STAGED" | sed 's|^framework/||' | xargs -I {} git add "framework/{}"
