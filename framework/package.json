{
  "name": "mars",
  "version": "0.0.0",
  "description": "A modular, lean, future-proof AI coding agent team behind a single TypeScript CLI.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.2.0"
  },
  "bin": {
    "mars": "./dist/cli/main.js"
  },
  "scripts": {
    "dev": "bun run cli/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "bunx tsc --noEmit",
    "release:binary": "bun build --compile --target=bun cli/main.ts --outfile=dist/mars"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "gray-matter": "^4.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "bun-types": "^1.2.0",
    "typescript": "^5.7.3"
  }
}
