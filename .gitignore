
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# macOS
.DS_Store
/.mars/
/.worktrees/

# DuckDB
*.duckdb
*.duckdb.wal

# Node / build artifacts
node_modules/
dist/
*.tsbuildinfo
.vite/

# Claude Code runtime — scheduled-tasks lock is a live runtime artifact
# (pid/sessionId/timestamps), never a tracked template. Match it anywhere so
# a leak (e.g. sync-claude-templates copying .claude/ into the template tree)
# can never dirty the working tree.
scheduled_tasks.lock

# mars install manifest — per-install runtime state, never committed.
mars.lock

# codegraph local index — per-machine SQLite knowledge graph + cache, rebuilt
# by `codegraph init` and kept fresh by the file-watcher. Never committed (the
# repo-root `.mcp.json` that registers the codegraph MCP server IS tracked;
# only this generated index directory is not).
.codegraph/

# Session-scoped git worktrees (sibling of the gitignored /.worktrees/).
.worktrees-session/

# Claude Code agent worktrees — live runtime artifacts, never tracked.
# Match anywhere (not just root) so a sync-claude-templates leak into the
# template tree can never dirty the working tree, same as the lock above.
.claude/worktrees/
**/templates/claude/worktrees/

# Package manager lock files (pnpm-lock.yaml is tracked; bun/npm are not)
ui/bun.lock
ui/package-lock.json

# Test runner artifacts
test-results/

# JVM crash dumps
hs_err_pid*

# Transient scratch files — operator debug dumps and stray screenshots that
# otherwise dirty the working tree and trip the main-committer dispatch guard.
# Verified clean before adding: `git ls-files | grep -E 'failed-tasks-'` → none.
# PNG pattern is root-anchored (/*.png) to stay narrow: the only tracked images
# are docs/assets/*.png (subdirectory), which are unaffected.
failed-tasks-*
/*.png

# Defensive: SqliteStore undefined-path artifacts (see PRD; validation lives in packages/workflow/src/store-sqlite.ts)
/orchestrator/undefined
/orchestrator/undefined-shm
/orchestrator/undefined-wal
