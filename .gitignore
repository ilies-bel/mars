
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# macOS
.DS_Store

# Per-repo state. NO trailing slash — see the node_modules note below: a
# trailing slash matches only real directories, and `.mars` is a plausible
# symlink target (sharing one daemon's Postgres/DSN across worktrees). Stays
# root-anchored, which IS intentional: only the repo-root `.mars` is state.
/.mars
/.worktrees/

# DuckDB
*.duckdb
*.duckdb.wal

# Node / build artifacts
#
# NO trailing slash on `node_modules` / `dist`, deliberately. In gitignore a
# trailing slash restricts the pattern to real DIRECTORIES, and a symlink is
# not a directory to git — it is a mode-120000 blob. Agent worktrees are
# routinely given a module tree by symlinking `node_modules` at the repo root
# instead of running a full install, and `node_modules/` let that symlink show
# up as untracked: a `git add -A` in a worktree staged it (caught and amended
# out; `git ls-files | grep -c node_modules` on main is 0, so nothing leaked).
# Slashless matches a directory, a symlink, or a file of that name, at any
# depth — which is what `orchestrator/.gitignore` and `ui/.gitignore` have
# always done. Do not "tidy" the slashes back on.
node_modules
dist
*.tsbuildinfo
.vite/

# Environment files. The root .gitignore never covered these — only
# `orchestrator/.gitignore` did — so a `.env` at the repo root was fully
# trackable. Matches at any depth, and covers `.env.local`, `.env.production`
# and friends. The `.env.example` negation is load-bearing: two are tracked
# (`orchestrator/`, `tools/ci-listener/`), and without it a re-add of either
# would be silently ignored. Neither parent directory is excluded, so the
# re-include is legal.
.env
.env.*
!.env.example

# Claude Code runtime — scheduled-tasks lock is a live runtime artifact
# (pid/sessionId/timestamps), never a tracked template. Match it anywhere so
# a leak (e.g. sync-claude-templates copying .claude/ into the template tree)
# can never dirty the working tree.
scheduled_tasks.lock

# mars install manifest — per-install runtime state, never committed.
mars.lock

# codegraph local index — per-machine SQLite knowledge graph + cache, rebuilt
# by `codegraph init` and kept fresh by the file-watcher. Never committed (the
# repo-root `.mcp.json` that registers the codegraph MCP server IS tracked;
# only this generated index directory is not).
.codegraph/

# Session-scoped git worktrees (sibling of the gitignored /.worktrees/).
.worktrees-session/

# Claude Code agent worktrees — live runtime artifacts, never tracked.
# Match anywhere (not just root) so a sync-claude-templates leak into the
# template tree can never dirty the working tree, same as the lock above.
.claude/worktrees/
**/templates/claude/worktrees/

# Package manager lock files (pnpm-lock.yaml is tracked; bun/npm are not).
# Only ui/ was listed, so a plain `npm install` in orchestrator/ or either
# packages/* left an untracked-but-not-ignored package-lock.json that is easy
# to commit by accident. Ignore them everywhere.
ui/bun.lock
package-lock.json
**/package-lock.json

# Test runner artifacts
test-results/

# JVM crash dumps
hs_err_pid*

# Transient scratch files — operator debug dumps and stray screenshots that
# otherwise dirty the working tree and trip the main-committer dispatch guard.
# Verified clean before adding: `git ls-files | grep -E 'failed-tasks-'` → none.
# PNG pattern is root-anchored (/*.png) to stay narrow: the only tracked images
# are docs/assets/*.png (subdirectory), which are unaffected.
failed-tasks-*
/*.png

# Defensive: SqliteStore undefined-path artifacts (see PRD; validation lives in packages/workflow/src/store-sqlite.ts)
/orchestrator/undefined
/orchestrator/undefined-shm
/orchestrator/undefined-wal
