                                  "width": "fill_container",
                                  "content": "## Output",
                                  "fontFamily": "JetBrains Mono",
                                  "fontSize": 11,
                                  "fontWeight": "600"
                                },
                                {
                                  "type": "text",
                                  "id": "J3sJ1",
