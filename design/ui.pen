                                  "content": "- Operate **only** in the assigned worktree.",
                                  "fontFamily": "JetBrains Mono",
                                  "fontSize": 11,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "VBrwQ",
                                  "fill": "$fg-light",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "- Never `--no-verify`, `reset --hard`, or force-push.",
                                  "fontFamily": "JetBrains Mono",
                                  "fontSize": 11,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "BY3lw",
                                  "fill": "$fg-light",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "- If conflict spans architectural intent, escalate.",
                                  "fontFamily": "JetBrains Mono",
                                  "fontSize": 11,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "MiFBt",
                                  "fill": "$fg-light",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "fontFamily": "JetBrains Mono",
