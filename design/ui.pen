                                  "id": "Ar9my",
                                  "fill": "$fg-light",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "Respond with a JSON envelope: { resolved, commit, notes }",
                                  "fontFamily": "JetBrains Mono",
                                  "fontSize": 11,
                                  "fontWeight": "normal"
