{
  "version": "2.11",
  "children": [
    {
      "type": "frame",
      "id": "nodes-root",
      "x": 0,
      "y": 0,
      "name": "Mars DS — Dependency graph: node visual language (slice 1/6)",
      "width": 1440,
      "fill": "$bg-light",
      "layout": "vertical",
      "gap": 56,
      "padding": 48,
      "children": [

        {
          "type": "frame",
          "id": "nodes-hdr",
          "name": "Artboard Header",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 6,
          "children": [
            {
              "type": "text",
              "id": "nodes-hdr-t",
              "name": "title",
              "fill": "$mars-night",
              "content": "Node visual language — dependency graph",
              "fontFamily": "Inter",
              "fontSize": 32,
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "nodes-hdr-s",
              "name": "sub",
              "fill": "$muted-light",
              "content": "Each node shows title and id only. Status is encoded by a 4 px left-edge accent bar. Shape (rounded-rect vs. dashed pill) distinguishes task nodes from idea-root nodes. Badges surface terminal harness failures.",
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "nodes-hdr-r",
              "name": "rules",
              "fill": "$muted-light",
              "content": "Colors are defined by the semantic palette in palette.md. No other text fields appear on the node itself — detail lives in the side-panel (slice 3/6).",
              "fontFamily": "Inter",
              "fontSize": 12,
              "fontWeight": "normal"
            }
          ]
        },

        {
          "type": "frame",
          "id": "sec-statuses",
          "name": "Section — task status variants",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 20,
          "children": [
            {
              "type": "text",
              "id": "sec-statuses-cap",
              "name": "sectionCaption",
              "fill": "$mars-night",
              "content": "1 — Task node: four status colors",
              "fontFamily": "Inter",
              "fontSize": 18,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "sec-statuses-sub",
              "name": "sectionSub",
              "fill": "$muted-light",
              "content": "Solid 1 px $border-light stroke, 8 px corner radius, $surface-light fill. Left accent bar = 4 px × full height, colored by semantic palette.",
              "fontFamily": "Inter",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "sec-statuses-row",
