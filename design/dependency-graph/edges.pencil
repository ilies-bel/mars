                  "type": "text",
                  "id": "sec2-hdr-s",
                  "name": "sectionSub",
                  "fill": "$muted-light",
                  "content": "Each edge kind carries one optional label, centered on its midpoint. Three label shapes exist. Labels are always italic, $muted-light, 11px Inter — never bold, never primary color.",
                  "fontFamily": "Inter",
                  "fontSize": 12,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "sec2-row",
              "name": "specimensRow",
              "width": "fill_container",
              "layout": "horizontal",
              "gap": 24,
              "alignItems": "start",
              "children": [

