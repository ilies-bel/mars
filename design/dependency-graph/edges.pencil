                    { "type": "text", "id": "spec-r1-dash", "fill": "$mars-night", "content": "none (solid)", "fontFamily": "JetBrains Mono", "fontSize": 12, "fontWeight": "normal", "width": 200 },
                    { "type": "text", "id": "spec-r1-width", "fill": "$mars-night", "content": "2", "fontFamily": "JetBrains Mono", "fontSize": 12, "fontWeight": "normal", "width": 140 },
                    { "type": "text", "id": "spec-r1-label", "fill": "$mars-night", "content": "slice n/total title  OR  failure-sig", "fontFamily": "Inter", "fontSize": 12, "fontWeight": "normal", "width": 240 }
                  ]
                },
                { "type": "frame", "id": "spec-sep2", "width": "fill_container", "height": 1, "fill": "$border-light" },
                {
                  "type": "frame",
                  "id": "spec-row2",
                  "name": "row: blocker",
                  "width": "fill_container",
                  "padding": [10, 12],
                  "layout": "horizontal",
                  "gap": 0,
                  "children": [
                    { "type": "text", "id": "spec-r2-kind", "fill": "$mars-night", "content": "blocker (waiting-on)", "fontFamily": "Inter", "fontSize": 12, "fontWeight": "normal", "width": 220 },
                    { "type": "text", "id": "spec-r2-stroke", "fill": "$mars-rust", "content": "$mars-rust", "fontFamily": "JetBrains Mono", "fontSize": 12, "fontWeight": "normal", "width": 160 },
                    { "type": "text", "id": "spec-r2-dash", "fill": "$mars-night", "content": "\"8 5\"", "fontFamily": "JetBrains Mono", "fontSize": 12, "fontWeight": "normal", "width": 200 },
                    { "type": "text", "id": "spec-r2-width", "fill": "$mars-night", "content": "2", "fontFamily": "JetBrains Mono", "fontSize": 12, "fontWeight": "normal", "width": 140 },
                    { "type": "text", "id": "spec-r2-label", "fill": "$mars-night", "content": "blocker reason  (omit if null)", "fontFamily": "Inter", "fontSize": 12, "fontWeight": "normal", "width": 240 }
                  ]
                },
                { "type": "frame", "id": "spec-sep3", "width": "fill_container", "height": 1, "fill": "$border-light" },
                {
                  "type": "frame",
                  "id": "spec-note-row",
                  "name": "noteRow",
                  "width": "fill_container",
                  "padding": [10, 12],
                  "layout": "horizontal",
                  "gap": 0,
                  "children": [
                    {
                      "type": "text",
                      "id": "spec-note-t",
                      "fill": "$muted-light",
                      "content": "All edges: marker-end arrowhead (SVG <marker> element), triangle filled with same color as stroke. Label: text-anchor=middle, dominant-baseline=hanging, dy=6px below midpoint, 11px Inter, $muted-light, italic. Omit label element entirely when value is null.",
                      "fontFamily": "Inter",
                      "fontSize": 11,
                      "fontWeight": "normal",
                      "fontStyle": "italic"
                    }
                  ]
                }
              ]
            }
          ]
        },

        {
          "type": "frame",
          "id": "legend",
          "name": "Legend — acceptance criteria checklist",
          "width": "fill_container",
          "fill": "$surface-light",
          "cornerRadius": 8,
          "stroke": { "align": "inside", "thickness": 1, "fill": "$border-light" },
          "padding": 20,
          "layout": "vertical",
          "gap": 8,
          "children": [
            {
              "type": "text",
              "id": "legend-t",
              "name": "legendTitle",
              "fill": "$mars-night",
              "content": "Slice 2 acceptance criteria — where they are satisfied in this draft",
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "legend-1",
              "name": "ac1",
              "fill": "$mars-night",
              "content": "✓ Solid originId-parent edge mock — Mock A (Section 1, left specimen): continuous $mars-night 2px line with ▶ arrowhead, from child task to parent task.",
              "fontFamily": "Inter",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "legend-2",
              "name": "ac2",
              "fill": "$mars-night",
              "content": "✓ Dashed blocker edge mock — Mock B (Section 1, right specimen): $mars-rust 8px/5px-gap dash segments with ▶ arrowhead, from waiting task to blocker task.",
              "fontFamily": "Inter",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "legend-3",
              "name": "ac3",
              "fill": "$mars-night",
              "content": "✓ Idea-to-task edge with slice index/title label — Mock C (Section 2, left specimen): solid edge from task node to $mars-ochre idea node, label \"2/6: Edge visual language draft\".",
              "fontFamily": "Inter",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "legend-4",
              "name": "ac4",
              "fill": "$mars-night",
              "content": "✓ Task-to-fix-task edge with failure-signature label — Mock D (Section 2, centre specimen): solid edge from fix-task node ($mars-rust border) to origin task node, label \"verify:typecheck-error\" (monospace).",
              "fontFamily": "Inter",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "legend-5",
              "name": "ac5",
              "fill": "$mars-night",
              "content": "✓ Blocker edge with blocker-reason label — Mock E (Section 2, right specimen): dashed edge, label \"prerequisite schema change\" (italic prose, omitted when null).",
              "fontFamily": "Inter",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "legend-6",
              "name": "ac6",
              "fill": "$mars-night",
              "content": "✓ Adjacent distinguishability — Section 3: solid ($mars-night, continuous) and dashed ($mars-rust, 8/5 gap) placed side by side at identical scale. Two independent signals (stroke style + hue) each sufficient alone.",
              "fontFamily": "Inter",
              "fontSize": 12,
              "fontWeight": "normal"
            }
          ]
        }

      ]
    }
  ]
}
