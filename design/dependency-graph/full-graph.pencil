                { "type": "path", "id": "leg-dashed-line", "name": "dashed-line", "d": "M 0 6 L 36 6", "stroke": { "fill": "$mars-night", "thickness": 2, "dashArray": "6 4" }, "markerEnd": { "type": "arrow", "fill": "$mars-night", "size": 6 } },
                { "type": "text", "id": "leg-dashed-lbl", "name": "label", "fill": "$mars-night", "content": "Blocker (waiting-on)", "fontFamily": "Inter", "fontSize": 12, "fontWeight": "500" }
              ]
            },
            {
              "type": "frame",
              "id": "leg-idea",
