{
  "version": "2.11",
  "children": [
    {
      "type": "frame",
      "id": "fg-artboard",
      "x": 0,
      "y": 0,
      "name": "Mars DS — Dependency graph: full-graph layout (slice 4/6)",
      "width": 1440,
      "height": 1080,
      "fill": "$bg-light",
      "layout": "vertical",
      "gap": 28,
      "padding": 48,
      "children": [

        {
          "type": "frame",
          "id": "fg-hdr",
          "name": "Header",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 6,
          "children": [
            {
              "type": "text",
              "id": "fg-hdr-t",
              "name": "title",
              "fill": "$mars-night",
              "content": "Full-graph layout — dependency closure on task-detail page",
              "fontFamily": "Inter",
              "fontSize": 32,
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "fg-hdr-s",
              "name": "subtitle",
              "fill": "$muted-light",
              "content": "Slice 4 of 6. Representative closure: originating idea → intermediate tasks → fix-task → current task (pinned right) + independent blocker chain. Depth from root, not time, drives column placement. Root nodes at left; current task pinned at right.",
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "fg-hdr-r",
              "name": "design-rules",
              "fill": "$muted-light",
              "content": "Solid edges = originId-parent lineage (why this task exists). Dashed edges = blocker (why this task is not done). Badge ★ on a fix-task node = recovery-failed or no-recipe. Single write affordance = inbox deep-link on the badge; no Resolve/Retry/Unblock controls in-view.",
              "fontFamily": "Inter",
              "fontSize": 12,
              "fontWeight": "normal"
            }
          ]
        },

        {
          "type": "frame",
          "id": "fg-legend",
          "name": "Legend",
          "width": "fill_container",
          "layout": "horizontal",
          "gap": 32,
          "alignItems": "center",
          "padding": 16,
          "fill": "$surface-light",
          "cornerRadius": 6,
          "stroke": { "align": "inside", "thickness": 1, "fill": "$border-light" },
          "children": [
            {
              "type": "frame",
              "id": "leg-solid",
              "name": "legend: solid edge",
              "layout": "horizontal",
              "gap": 8,
              "alignItems": "center",
              "children": [
                { "type": "path", "id": "leg-solid-line", "name": "solid-line", "d": "M 0 6 L 36 6", "stroke": { "fill": "$mars-night", "thickness": 2 }, "markerEnd": { "type": "arrow", "fill": "$mars-night", "size": 6 } },
                { "type": "text", "id": "leg-solid-lbl", "name": "label", "fill": "$mars-night", "content": "Lineage (originId-parent)", "fontFamily": "Inter", "fontSize": 12, "fontWeight": "500" }
              ]
            },
            {
              "type": "frame",
              "id": "leg-dashed",
              "name": "legend: dashed edge",
              "layout": "horizontal",
              "gap": 8,
              "alignItems": "center",
