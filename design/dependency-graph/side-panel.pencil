                              "type": "text",
                              "id": "panelB-f2-v",
                              "name": "value — explicit absence wording, not '(none)' or empty box",
                              "fill": "$muted-light",
                              "content": "— this task has not spawned a fix-task",
                              "fontFamily": "Inter",
                              "fontSize": 12,
                              "fontWeight": "normal",
                              "fontStyle": "italic"
                            }
                          ]
                        },

                        {
                          "type": "frame",
                          "id": "panelB-f3",
                          "name": "field: worktree path",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 4,
                          "children": [
                            {
                              "type": "text",
                              "id": "panelB-f3-l",
                              "name": "label",
                              "fill": "$muted-light",
                              "content": "WORKTREE PATH",
                              "fontFamily": "Inter",
                              "fontSize": 10,
                              "fontWeight": "600",
                              "letterSpacing": 0.5
                            },
                            {
                              "type": "text",
                              "id": "panelB-f3-v",
                              "name": "value",
                              "fill": "$mars-night",
                              "content": ".mars/worktrees/mars-3e8e0f12/",
                              "fontFamily": "JetBrains Mono",
                              "fontSize": 12,
                              "fontWeight": "normal"
                            }
                          ]
                        },

                        {
                          "type": "frame",
                          "id": "panelB-f4",
                          "name": "field: final commit (absent — task in flight, no final commit yet)",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 4,
                          "children": [
                            {
                              "type": "text",
                              "id": "panelB-f4-l",
                              "name": "label",
                              "fill": "$muted-light",
                              "content": "FINAL COMMIT",
                              "fontFamily": "Inter",
                              "fontSize": 10,
                              "fontWeight": "600",
                              "letterSpacing": 0.5
                            },
                            {
                              "type": "text",
                              "id": "panelB-f4-v",
                              "name": "value — explicit absence wording, scoped to status",
                              "fill": "$muted-light",
                              "content": "— task is still in flight; no final commit yet",
                              "fontFamily": "Inter",
                              "fontSize": 12,
                              "fontWeight": "normal",
                              "fontStyle": "italic"
                            }
                          ]
                        },

                        {
                          "type": "frame",
                          "id": "panelB-f5",
                          "name": "field: error text (absent — task has not errored)",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 4,
                          "children": [
                            {
                              "type": "text",
                              "id": "panelB-f5-l",
                              "name": "label",
                              "fill": "$muted-light",
                              "content": "ERROR TEXT",
                              "fontFamily": "Inter",
                              "fontSize": 10,
                              "fontWeight": "600",
                              "letterSpacing": 0.5
                            },
                            {
                              "type": "text",
                              "id": "panelB-f5-v",
                              "name": "value — explicit absence wording",
                              "fill": "$muted-light",
                              "content": "— task has not produced an error",
                              "fontFamily": "Inter",
                              "fontSize": 12,
                              "fontWeight": "normal",
                              "fontStyle": "italic"
                            }
                          ]
                        },

                        {
                          "type": "frame",
                          "id": "panelB-f6",
                          "name": "field: blocker list (empty — no blockers)",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 4,
                          "children": [
                            {
                              "type": "text",
                              "id": "panelB-f6-l",
                              "name": "label",
                              "fill": "$muted-light",
                              "content": "BLOCKED BY (0)",
                              "fontFamily": "Inter",
                              "fontSize": 10,
                              "fontWeight": "600",
                              "letterSpacing": 0.5
                            },
                            {
                              "type": "text",
                              "id": "panelB-f6-v",
                              "name": "value — explicit absence wording, not '(none)'",
                              "fill": "$muted-light",
                              "content": "— task is not waiting on anything",
                              "fontFamily": "Inter",
                              "fontSize": 12,
                              "fontWeight": "normal",
                              "fontStyle": "italic"
                            }
                          ]
                        }
                      ]
                    },

                    { "type": "frame", "id": "panelB-sep3", "name": "sep", "width": "fill_container", "height": 1, "fill": "$border-light" },

                    {
                      "type": "frame",
                      "id": "panelB-foot",
                      "name": "panelFooter — read-only notice",
                      "width": "fill_container",
                      "padding": 12,
                      "fill": "$bg-light",
                      "layout": "horizontal",
                      "gap": 6,
                      "alignItems": "center",
                      "children": [
                        {
                          "type": "text",
                          "id": "panelB-foot-i",
                          "name": "lockIcon",
                          "fill": "$muted-light",
                          "content": "🔒",
                          "fontFamily": "Inter",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "panelB-foot-t",
                          "name": "footerText",
                          "fill": "$muted-light",
                          "content": "Read-only. Resolve / retry / unblock live in /mars:inbox and the CLI.",
                          "fontFamily": "Inter",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                },

                {
                  "type": "text",
                  "id": "mockB-note",
                  "name": "designNote",
                  "fill": "$muted-light",
                  "content": "Absent-field rule: sections that cannot apply (FAILURE SIGNATURE, INBOX) are omitted from the panel entirely and called out once at the top. Sections that may apply but happen to be empty for this particular task (FIX-TASK, FINAL COMMIT, ERROR TEXT, BLOCKED BY) keep their label and replace the value with explicit italic prose — never '(none)', never an empty input.",
                  "fontFamily": "Inter",
                  "fontSize": 11,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },

        {
          "type": "frame",
          "id": "legend",
          "name": "Legend — acceptance criteria checklist",
          "width": "fill_container",
          "fill": "$surface-light",
          "cornerRadius": 8,
          "stroke": { "align": "inside", "thickness": 1, "fill": "$border-light" },
          "padding": 20,
          "layout": "vertical",
          "gap": 8,
          "children": [
            {
              "type": "text",
              "id": "legend-t",
              "name": "legendTitle",
              "fill": "$mars-night",
              "content": "Slice 3 acceptance criteria — where they show up in this draft",
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "legend-1",
              "name": "ac1",
              "fill": "$mars-night",
              "content": "✓ All required fields labelled on Mock A: FAILURE SIGNATURE, FIX-TASK, WORKTREE PATH, FINAL COMMIT, ERROR TEXT, BLOCKED BY, INBOX.",
              "fontFamily": "Inter",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "legend-2",
              "name": "ac2",
              "fill": "$mars-night",
              "content": "✓ Mock B has no failure signature and no inbox item — both are removed from the panel and explained once at the top, not rendered as empty placeholders.",
              "fontFamily": "Inter",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "legend-3",
              "name": "ac3",
              "fill": "$mars-night",
              "content": "✓ Inbox deep-link styled as a navigation affordance: arrow icon (↗), link-color stroke + underlined link-color text, label reads 'Open in /mars:inbox'. Distinct from any button styling.",
              "fontFamily": "Inter",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "legend-4",
              "name": "ac4",
              "fill": "$mars-night",
              "content": "✓ No write controls (Resolve / Retry / Unblock) appear in either mock; footer reiterates that those actions live in /mars:inbox and the CLI.",
              "fontFamily": "Inter",
              "fontSize": 12,
              "fontWeight": "normal"
            }
          ]
        }
      ]
    }
  ]
}
