{
  "version": "2.11",
  "children": [
    {
      "type": "frame",
      "id": "sp-root",
      "x": 0,
      "y": 0,
      "name": "Mars DS — Dependency graph: side-panel (slice 3/6)",
      "width": 1440,
      "fill": "$bg-light",
      "layout": "vertical",
      "gap": 32,
      "padding": 48,
      "children": [
        {
          "type": "frame",
          "id": "sp-hdr",
          "name": "Artboard Header",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 6,
          "children": [
            {
              "type": "text",
              "id": "sp-hdr-t",
              "name": "title",
              "fill": "$mars-night",
              "content": "Side-panel — task-detail dependency graph",
              "fontFamily": "Inter",
              "fontSize": 32,
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "sp-hdr-s",
              "name": "sub",
              "fill": "$muted-light",
              "content": "Opens when operator clicks a node in the graph. Read-only. Shows the detail the node itself omits.",
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "sp-hdr-r",
              "name": "rules",
              "fill": "$muted-light",
              "content": "No write controls (no Resolve / Retry / Unblock buttons). Inbox link is a navigation affordance — clicking it routes to /mars:inbox, never acts in place.",
              "fontFamily": "Inter",
              "fontSize": 12,
              "fontWeight": "normal"
            }
          ]
        },

        {
          "type": "frame",
          "id": "sp-row",
          "name": "Mocks row",
          "width": "fill_container",
          "layout": "horizontal",
          "gap": 32,
          "alignItems": "start",
          "children": [

            {
              "type": "frame",
              "id": "mockA",
              "name": "Mock A — full detail",
              "width": 480,
              "layout": "vertical",
              "gap": 12,
              "children": [
                {
                  "type": "text",
                  "id": "mockA-cap",
                  "name": "caption",
                  "fill": "$mars-night",
                  "content": "A. Node with every field populated",
                  "fontFamily": "Inter",
                  "fontSize": 16,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "mockA-cap-sub",
                  "name": "captionSub",
                  "fill": "$muted-light",
                  "content": "Failed task that spawned a fix-task and produced an inbox item.",
                  "fontFamily": "Inter",
                  "fontSize": 12,
                  "fontWeight": "normal"
                },

                {
                  "type": "frame",
                  "id": "panelA",
                  "name": "side-panel",
                  "width": "fill_container",
                  "fill": "$surface-light",
                  "cornerRadius": 8,
                  "stroke": { "align": "inside", "thickness": 1, "fill": "$border-light" },
                  "layout": "vertical",
                  "gap": 0,
                  "children": [

                    {
                      "type": "frame",
                      "id": "panelA-hdr",
                      "name": "panelHeader",
                      "width": "fill_container",
                      "layout": "vertical",
