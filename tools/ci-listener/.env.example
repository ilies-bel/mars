# Shared secret you set in GitHub repo Settings → Webhooks
GH_WEBHOOK_SECRET=replace-with-openssl-rand-hex-32

# Absolute path to the target repo whose .mars/queue.db should receive tasks
MARS_REPO=/Users/you/project/perso/mars-framework

# smee.io channel created at https://smee.io/new
SMEE_URL=https://smee.io/your-channel-id

# Optional
PORT=7878
ONLY_FAILURES=0
