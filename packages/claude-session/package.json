{
  "name": "@mars/claude-session",
  "version": "0.1.0",
  "description": "Standalone library for programmatically controlling interactive Claude sessions.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "node -e \"var fs=require('fs'),path=require('path'),g=path.join(__dirname,'node_modules/node-pty/prebuilds');try{fs.readdirSync(g).forEach(function(d){var f=path.join(g,d,'spawn-helper');try{fs.chmodSync(f,0o755);}catch(e){}});}catch(e){}\""
  },
  "dependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3",
    "vitest": "^2.1.9"
  }
}
