{
  "name": "mars",
  "version": "0.1.0",
  "description": "Orchestrator that runs Claude Code in parallel git worktrees on the in-house @mars/workflow engine.",
  "main": "src/cli.ts",
  "bin": {
    "mars": "./bin/mars.mjs"
  },
  "scripts": {
    "sync-claude-templates": "bash ./scripts/sync-claude-templates.sh",
    "mars:bundle:refresh": "bash ./scripts/sync-claude-templates.sh",
    "sync-version": "node ./scripts/sync-version.mjs",
    "prebuild": "node ./scripts/sync-version.mjs",
    "build": "tsc --noEmit",
    "pretest": "node ./scripts/sync-version.mjs",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "cli": "tsx src/cli.ts",
    "build:binary": "bash scripts/build-binary.sh",
    "typecheck": "tsc --noEmit",
    "knip": "knip --no-exit-code"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@mars/workflow": "file:../packages/workflow",
    "ink": "^7.0.2",
    "react": "^19.2.0",
    "tsx": "^4.21.0",
    "ws": "^8.20.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.0",
    "@types/ws": "^8.5.13",
    "knip": "^6.14.0",
    "typescript": "^6.0.3",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
