{
  "name": "mars",
  "version": "0.1.0",
  "description": "Mastra-driven orchestrator that runs Claude Code in parallel git worktrees.",
  "main": "src/cli.ts",
  "bin": {
    "mars": "./bin/mars.mjs"
  },
  "scripts": {
    "sync-claude-templates": "bash ./scripts/sync-claude-templates.sh",
    "mars:bundle:refresh": "bash ./scripts/sync-claude-templates.sh",
    "sync-version": "node ./scripts/sync-version.mjs",
    "prebuild": "node ./scripts/sync-version.mjs",
    "pretest": "node ./scripts/sync-version.mjs",
    "test": "vitest run",
    "dev": "mastra dev",
    "build": "mastra build",
    "start": "mastra start",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "knip": "knip --no-exit-code"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.2-r.1",
    "@libsql/client": "^0.17.3",
    "@mastra/core": "^1.29.0",
    "@mastra/duckdb": "^1.2.0",
    "@mastra/libsql": "^1.9.0",
    "@mastra/loggers": "^1.1.1",
    "@mastra/observability": "^1.10.1",
    "ink": "^7.0.2",
    "react": "^19.2.0",
    "tsx": "^4.21.0",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.0",
    "@types/ws": "^8.5.13",
    "knip": "^6.14.0",
    "mastra": "^1.7.0",
    "typescript": "^6.0.3",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
