{
  "name": "mars",
  "version": "0.1.1",
  "description": "Orchestrator that runs Claude Code in parallel git worktrees on the in-house @mars/workflow engine.",
  "main": "src/cli.ts",
  "bin": {
    "mars": "./bin/mars.mjs"
  },
  "exports": {
    ".": "./src/cli.ts",
    "./workflow": "./src/workflows/authoring.ts"
  },
  "scripts": {
    "sync-claude-templates": "bash ./scripts/sync-claude-templates.sh",
    "mars:bundle:refresh": "bash ./scripts/sync-claude-templates.sh",
    "sync-version": "node ./scripts/sync-version.mjs",
    "prebuild": "node ./scripts/sync-version.mjs",
    "build": "tsc --noEmit",
    "pretest": "node ./scripts/sync-version.mjs",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "cli": "tsx src/cli.ts",
    "build:binary": "tsx scripts/build-binary.ts",
    "pretypecheck": "pnpm --dir ../packages/workflow run build || (ls ../packages/workflow/dist/index.d.ts > /dev/null 2>&1 && echo '[pretypecheck] workflow node_modules absent, using existing dist' || (echo '[pretypecheck] workflow dist missing — run: (cd ../packages/workflow && pnpm install && pnpm run build)' && exit 1))",
    "typecheck": "tsc --noEmit",
    "knip": "knip --no-exit-code",
    "postinstall": "node scripts/fix-pty-perms.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@mars/workflow": "file:../packages/workflow",
    "ink": "^7.0.2",
    "js-yaml": "^4.1.1",
    "node-pty": "^1.1.0",
    "react": "^19.2.0",
    "smol-toml": "^1.6.1",
    "tsx": "^4.21.0",
    "ws": "^8.20.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.0",
    "@types/ws": "^8.5.13",
    "knip": "^6.14.0",
    "typescript": "^6.0.3",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@mars/workflow",
      "node-pty"
    ]
  }
}
