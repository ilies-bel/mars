{
  "name": "@mars/ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Dashboard for the Mars orchestrator — tasks, action queue, KPIs, and trace events.",
  "bin": {
    "mars-ui": "./bin/mars-ui.mjs"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "bun --watch run server/index.ts",
    "dev:all": "node -e \"const {spawn}=require('node:child_process');const opts={stdio:'inherit',shell:true};const a=spawn('npm',['run','dev:server'],opts);const b=spawn('npm',['run','dev'],opts);const kill=()=>{a.kill('SIGINT');b.kill('SIGINT')};process.on('SIGINT',kill);process.on('SIGTERM',kill);a.on('exit',c=>{b.kill('SIGINT');process.exit(c||0)});b.on('exit',c=>{a.kill('SIGINT');process.exit(c||0)});\"",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "npm run lint:tokens && npm run test:src && npm run test:server",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "test:src": "vitest run",
    "test:server": "bun test server/",
    "lint": "knip --no-exit-code",
    "start": "node bin/mars-ui.mjs",
    "knip": "knip --no-exit-code"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.37",
    "@dagrejs/dagre": "^3.0.0",
    "@fontsource/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@libsql/client": "^0.17.3",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-virtual": "^3.13.26",
    "@xyflow/react": "^12.11.2",
    "ai": "^7.0.34",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "radix-ui": "^1.6.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.0",
    "happy-dom": "^20.10.6",
    "knip": "^6.14.0",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
